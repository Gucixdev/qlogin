#!/usr/bin/env bash
# rundemovm - boot a throw-away qemu VM (host kernel, tiny initramfs) with qlogin as the REAL login on its console: real PAM against a real shadow
# file, real qlogind, real setuid. No arguments. In the VM: user demo, password secret. After the right password a small "demo" session prints who
# you are and the logind session list for 3 s and ends: the login is over and the VM powers off (nothing to quit from). Ctrl-D with both fields
# empty also ends it; Ctrl-S before Enter shows the picker (demo, Shell). Nothing on this machine is changed (no network, no mounts).
set -eu
here=$(dirname "$(readlink -f "$0")")
. "$here/tests/vmlib.sh"
vm_need
T=$(mktemp -d /tmp/qlogin-vm.XXXXXX); trap 'rm -rf "$T"' EXIT
vm_build "$T" || { echo "rundemovm: building the image failed" >&2; exit 1; }
eval "$(vm_qemu "$T")"
