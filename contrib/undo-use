#!/bin/sh
# undo-use - run as root: SDDM is the login again (autologin session stays whatever /etc/sddm.conf says).
set -eu
[ "$(id -u)" = 0 ] || { echo "undo-use: run it as root (sudo)" >&2; exit 1; }
systemctl disable qlogin@tty1.service
systemctl enable sddm.service
echo "SDDM enabled again, reboot to use it"
