#!/usr/bin/env bash
# install - build qlogin and qlogind and install them for the current user: no root; the one flag is -rebuild (full rebuild first).
# Binaries go to ~/.local/bin (qlogin) and ~/.local/sbin (qlogind), man pages to ~/.local/share/man. PREFIX=/usr/local (and
# sudo) installs system-wide, DESTDIR is for packagers. Installing does not make qlogin the login of the machine and does not
# touch /etc: the service files and the PAM stack are in contrib/ and stay yours to copy.
set -eu
cd "$(dirname "$(readlink -f "$0")")"
rebuild=
[ "${1:-}" = -rebuild ] && { rebuild=1; shift; }
[ $# -eq 0 ] || { echo "install: the only argument is -rebuild (full rebuild first); PREFIX=... in the environment changes the target" >&2; exit 2; }
export BUILD_FORCE=$rebuild
prefix=${PREFIX:-$HOME/.local}
./build > /dev/null
make --quiet install PREFIX="$prefix" DESTDIR="${DESTDIR:-}"
echo "qlogin installed in ${DESTDIR:-}$prefix/bin, qlogind in ${DESTDIR:-}$prefix/sbin"
case ":$PATH:" in
	*":${DESTDIR:-}$prefix/bin:"*) ;;
	*) [ -n "${DESTDIR:-}" ] || echo "note: $prefix/bin is not in PATH; add it to your shell profile" ;;
esac
